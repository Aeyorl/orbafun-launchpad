    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28"
  },
  "overrides": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "axios": "1.19.0",
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "uuid": "11.1.1",
    "ws": "8.21.1"
  }
}
