  "private": true,
  "license": "BSL-1.1",
  "description": "First memecoin launchpad on Arc — pump.fun mechanics, USDC-native",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
