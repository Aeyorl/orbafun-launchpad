# This file is a checklist, not a source of authoritative Arc parameters.
# Fill only after Circle publishes final mainnet values and the external audit closes.
NODE_ENV=production
CORS_ORIGIN=https://orba.fun,https://www.orba.fun
AUTH_ALLOW_INSECURE=false
AUTH_SIWE_DOMAINS=orba.fun,www.orba.fun

ARC_CHAIN_ID=5042
ARC_RPC_URLS=
ARC_WS_URL=
ARC_USDC_ADDRESS=
ARC_TOKEN_FACTORY_ADDRESS=
ARC_TREASURY_ADDRESS=
ARC_MIGRATOR_ADDRESS=
ARC_AMM_FACTORY_ADDRESS=
ARC_AMM_ROUTER_ADDRESS=
ARC_TIMELOCK_ADDRESS=
ADMIN_MULTISIG=

# Runtime bytecode hashes from the externally audited deployment manifest.
ARC_TOKEN_FACTORY_RUNTIME_CODE_HASH=
ARC_TREASURY_RUNTIME_CODE_HASH=
ARC_MIGRATOR_RUNTIME_CODE_HASH=
ARC_AMM_FACTORY_RUNTIME_CODE_HASH=
ARC_AMM_ROUTER_RUNTIME_CODE_HASH=
ARC_TIMELOCK_RUNTIME_CODE_HASH=

# Raw private keys are forbidden. AWS KMS uses a non-exportable secp256k1 key;
# platform-funded actions stay disabled until its policy is externally reviewed.
DEPLOYER_SIGNER_PROVIDER=aws-kms
AWS_REGION=
AWS_KMS_KEY_ID=
AWS_KMS_EXPECTED_ADDRESS=
DEPLOYER_ACTIONS_ENABLED=false
DEPLOYER_MAX_ACTION_MICRO_USDC=
DEPLOYER_MAX_BALANCE_MICRO_USDC=
DEPLOYER_MIN_BALANCE_MICRO_USDC=
PLATFORM_DEPLOYER_DAILY_LIMIT_MICRO_USDC=
PLATFORM_DEPLOYER_MONTHLY_LIMIT_MICRO_USDC=
AGENT_EXECUTOR_ENABLED=false

MONITORING_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
RPC_MIN_HEALTHY_PROVIDERS=2
RPC_MAX_DIVERGENCE_BLOCKS=8
INDEXER_MAX_LAG_BLOCKS=60
POSTGRES_POOL_WARN_PERCENT=80
REDIS_KEY_WARN_COUNT=
UPSTASH_ALERTS_CONFIGURED=false

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=orbafun
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL_CA_BASE64=
POSTGRES_RUNTIME_ROLE=orbafun_runtime
POSTGRES_RUNTIME_USER=
POSTGRES_RUNTIME_PASSWORD=
REDIS_URL=rediss://
REDIS_SSL_CA_BASE64=

AUTH_SECRET=
PINATA_JWT=
ADMIN_WALLETS=

MAINNET_CONFIGURATION_APPROVED=true
INCIDENT_CONTACTS_CONFIGURED=true
EXTERNAL_AUDIT_REPORT_URL=
EXTERNAL_AUDIT_COMMIT=
BACKUP_RESTORE_DRILL_AT=
