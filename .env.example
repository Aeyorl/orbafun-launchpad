# Arc Testnet (confirmed from docs — see DECISION_LOG.md)
# Arc testnet RPC � rotate between all 4 public providers to avoid rate limits.
# Each provider has independent -32011 rate-limit buckets, so rotation gives
# us 4x the effective quota. Override with your own endpoints if needed.
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_EXPLORER_API_URL=https://testnet.arcscan.app
ARC_RPC_URLS=https://rpc.testnet.arc.network,https://rpc.drpc.testnet.arc.network,https://rpc.quicknode.testnet.arc.network,https://rpc.blockdaemon.testnet.arc.network
ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URLS=https://rpc.testnet.arc.network,https://rpc.drpc.testnet.arc.network,https://rpc.quicknode.testnet.arc.network,https://rpc.blockdaemon.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_WS_URL=wss://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# Mainnet release gate. Set to true only after Circle has published the final
# Arc mainnet parameters and two reviewers have recorded their source/evidence.
ARC_MAINNET_PARAMETERS_APPROVED=false
# Mainnet-only release evidence. These remain false/empty on testnet. The
# readiness check requires explorer-verified source and transaction evidence
# from a full production-threshold graduation plus post-graduation buy/sell.
CONTRACT_SOURCES_VERIFIED=false
PRODUCTION_GRADUATION_TEST_PASSED=false
PRODUCTION_GRADUATION_EVIDENCE_URL=
PRODUCTION_GRADUATION_TX_HASH=
PRODUCTION_AMM_BUY_TX_HASH=
PRODUCTION_AMM_SELL_TX_HASH=
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_NATIVE_USDC_EMITTER=0xfffffffffffffffffffffffffffffffffffffffe
ARC_BLOCKLISTED_TEST_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Verified hardened graduation/AMM contract stack (Arc Testnet, factory block 59870678)
ARC_TREASURY_ADDRESS=0x41712d8cebdAfc5b7eac343F2add73288248bd5c
ARC_AMM_FACTORY_ADDRESS=0x9f2E34c3A32819268E6e37c0Cb76F53724F222b1
ARC_AMM_ROUTER_ADDRESS=0x194f27364bAdE80DF0C5b4f31CcE667FF6ea8F39
ARC_TIMELOCK_ADDRESS=0x23a038742a12d9D8ABcfF62c5bFA36b608fFe17e
ADMIN_MULTISIG=0x33E4bd4561EE669012ff83b4eE5609122838bDcB
ARC_TOKEN_FACTORY_ADDRESS=0x3dD9bA8Aa1d92ebfdBE10438618d643757bE64B3
# Poll only explicitly indexed factories. This fresh-start release excludes
# the legacy deployment while preserving its rows in PostgreSQL.
TOKEN_FACTORY_ADDRESSES=0x3dD9bA8Aa1d92ebfdBE10438618d643757bE64B3
PUBLIC_TOKEN_FACTORY_ADDRESSES=0x3dD9bA8Aa1d92ebfdBE10438618d643757bE64B3
# Add only factories whose MemeToken bytecode has no max-wallet restriction.
UNCAPPED_TOKEN_FACTORY_ADDRESSES=0x3dD9bA8Aa1d92ebfdBE10438618d643757bE64B3
# Optional one-release replay override for a newly added factory. Both values
# are required so a stale block number cannot rewind the indexer after restart.
ARC_POLLER_REPLAY_ENABLED=false
# ARC_POLLER_REPLAY_FROM_BLOCK=
ARC_DEPLOYMENT_BLOCK=59870676
ARC_MIGRATOR_ADDRESS=0x93E16Bd952E3d60a99E27BB7ED06A612Def7a77d

# Frontend copies of the active deployment addresses. Mainnet builds fail
# closed if any are absent; never reuse these testnet values on mainnet.
NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=0x3dD9bA8Aa1d92ebfdBE10438618d643757bE64B3
NEXT_PUBLIC_UNCAPPED_TOKEN_FACTORY_ADDRESSES=0x3dD9bA8Aa1d92ebfdBE10438618d643757bE64B3
NEXT_PUBLIC_TREASURY_ADDRESS=0x41712d8cebdAfc5b7eac343F2add73288248bd5c
NEXT_PUBLIC_MIGRATOR_ADDRESS=0x93E16Bd952E3d60a99E27BB7ED06A612Def7a77d
NEXT_PUBLIC_AMM_FACTORY_ADDRESS=0x9f2E34c3A32819268E6e37c0Cb76F53724F222b1
NEXT_PUBLIC_AMM_ROUTER_ADDRESS=0x194f27364bAdE80DF0C5b4f31CcE667FF6ea8F39

# Deployer (testnet only — NEVER commit real values)
DEPLOYER_PRIVATE_KEY=
DEPLOYER_SIGNER_PROVIDER=local
# Mainnet signer (DEPLOYER_SIGNER_PROVIDER=aws-kms). The KMS key must be
# ECC_SECG_P256K1 / SIGN_VERIFY and its derived address must match exactly.
AWS_REGION=
AWS_KMS_KEY_ID=
AWS_KMS_EXPECTED_ADDRESS=
DEPLOYER_ACTIONS_ENABLED=false
# Required when funded actions are enabled; integer micro-USDC (1 USDC = 1000000).
DEPLOYER_MAX_ACTION_MICRO_USDC=
DEPLOYER_MAX_BALANCE_MICRO_USDC=
DEPLOYER_MIN_BALANCE_MICRO_USDC=
PLATFORM_DEPLOYER_DAILY_LIMIT_MICRO_USDC=
PLATFORM_DEPLOYER_MONTHLY_LIMIT_MICRO_USDC=

# Production monitoring and alert thresholds.
MONITORING_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
RPC_MIN_HEALTHY_PROVIDERS=2
RPC_MAX_DIVERGENCE_BLOCKS=8
INDEXER_MAX_LAG_BLOCKS=60
POSTGRES_POOL_WARN_PERCENT=80
REDIS_KEY_WARN_COUNT=
DEPLOYER_MONITOR_ADDRESS=

# Authenticated image-upload budgets. Redis is required and the endpoint fails
# closed when it cannot atomically reserve quota.
UPLOAD_WALLET_DAILY_FILES=12
UPLOAD_WALLET_DAILY_BYTES=31457280
UPLOAD_GLOBAL_DAILY_FILES=2000
UPLOAD_GLOBAL_DAILY_BYTES=2147483648

# Admin wallets — comma-separated EVM addresses allowed to register agents
# and manage the deployer wallet. Typically the same as the deployer wallet.
ADMIN_WALLETS=

# Backend — PostgreSQL (defaults match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orbafun
POSTGRES_USER=orbafun
POSTGRES_PASSWORD=orbafun_dev_password
# Production runtime must use this non-owner, non-BYPASSRLS role. For a
# Supabase pooler, the API derives orbafun_runtime.<project-ref> from the
# migration username postgres.<project-ref>; override POSTGRES_RUNTIME_USER
# only when your provider uses a different connection username.
POSTGRES_RUNTIME_ROLE=orbafun_runtime
POSTGRES_RUNTIME_USER=
POSTGRES_RUNTIME_PASSWORD=

# Backend — Redis
REDIS_URL=redis://localhost:6379

# API server
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Frontend (Next.js) — production values for the orba.fun domain.
# Set these in Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_SITE_URL is used for metadataBase (OG/Twitter cards) and must
# be the canonical production URL (no trailing slash).
# NEXT_PUBLIC_API_URL must point at the deployed backend (e.g. Render).
# NEXT_PUBLIC_WS_URL is the same host as the API (wss:// if the API serves TLS).
NEXT_PUBLIC_SITE_URL=https://orba.fun
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
# WalletConnect Cloud project ID. Register a production project at
# https://cloud.walletconnect.com and configure its allowed Orba origins.
# When omitted, Orba remains usable with injected browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# TradingView Advanced Charts (licensed private GitHub repository).
# Local: point at your official charting_library clone.
# Vercel: set TRADINGVIEW_GITHUB_TOKEN as a Sensitive Environment Variable
# using the narrowest token GitHub permits for your licensed repository access.
# Never prefix these variables with NEXT_PUBLIC_ and never commit the token.
TRADINGVIEW_LIBRARY_PATH=
TRADINGVIEW_GITHUB_TOKEN=
TRADINGVIEW_LIBRARY_REF=470eec1bba4ada14e0f0b12dd17ca56ae81f36ff
# Set to true in CI jobs that must include verified Advanced Charts assets.
TRADINGVIEW_REQUIRED=false

# Auth (wallet signature auth for write endpoints)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Allow insecure x-wallet header fallback (testnet only — set to 'false' or remove for mainnet)
AUTH_ALLOW_INSECURE=false

# Indexer webhook authentication (shared secret between Envio and API)
INDEXER_WEBHOOK_SECRET=

# Envio HyperIndex (optional — for GraphQL polling fallback)
INDEXER_GRAPHQL_URL=http://localhost:8080/v1/graphql
INDEXER_GRAPHQL_SECRET=testing

# Circle App Kit (optional, if using App Kit features)
KIT_KEY=

# Pinata IPFS — for token image uploads on the launch form.
# Get a free key at https://app.pinata.cloud/ (Developers → API Keys).
# Leave empty to disable uploads (the launch form falls back to URL input).
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
# Browser gateway used to render stored ipfs:// token images. Defaults to the
# Pinata public gateway when omitted; set a dedicated gateway here if available.
NEXT_PUBLIC_IPFS_GATEWAY=https://silver-tricky-kite-593.mypinata.cloud

# AI Agent Launches — the deployer wallet submits createToken() on behalf
# of registered AI agents. The wallet must have USDC for the 5 USDC creation
# fee + gas. Fund it from the Circle faucet (testnet).
# Each launch approves only the exact current creation fee for TokenFactory.
# DEPLOYER_PRIVATE_KEY is shared with the e2e test scripts — same wallet.
# (Already set above, but documented here for the agent launch feature.)
AGENT_EXECUTOR_ENABLED=false  # set to true to enable autonomous agent executor

# Required for contract deployment and ownership migration. Use a Safe or
# equivalent hardware-backed multisig, never the Render deployer EOA.
TIMELOCK_DELAY_SECONDS=172800
AUTH_SIWE_DOMAINS=orba.fun,www.orba.fun,localhost:3000
# Default referral accrual in basis points of eligible trading volume (10 = 0.1%).
# Admin-created partner codes can snapshot a different rate, capped at 100 bps.
REFERRAL_REWARD_PCT_BPS=10
POSTGRES_SSL_CA_BASE64=
REDIS_SSL_CA_BASE64=
TOKEN_FACTORY_APPROVAL_CAP_USDC=50000000
TRUST_PROXY_HOPS=1
