# Arc Testnet (confirmed from docs — see DECISION_LOG.md)
# Arc testnet RPC � rotate between all 4 public providers to avoid rate limits.
# Each provider has independent -32011 rate-limit buckets, so rotation gives
# us 4x the effective quota. Override with your own endpoints if needed.
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_RPC_URLS=https://rpc.testnet.arc.network,https://rpc.drpc.testnet.arc.network,https://rpc.quicknode.testnet.arc.network,https://rpc.blockdaemon.testnet.arc.network
ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URLS=https://rpc.testnet.arc.network,https://rpc.drpc.testnet.arc.network,https://rpc.quicknode.testnet.arc.network,https://rpc.blockdaemon.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_WS_URL=wss://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_NATIVE_USDC_EMITTER=0xfffffffffffffffffffffffffffffffffffffffe
ARC_BLOCKLISTED_TEST_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Deployed contract addresses (Arc Testnet, block 53270227 — with security fixes)
ARC_TREASURY_ADDRESS=0x2cAc61423fe5d7e74e5f3504901478F52a71156D
ARC_AMM_FACTORY_ADDRESS=0x4058646F179a4f5dF430E8e125b8F30fF3489BF9
ARC_TOKEN_FACTORY_ADDRESS=0x8b59B3c4B7A634d8599e4DFB6891CEefd5CA424b
ARC_MIGRATOR_ADDRESS=0x34d4eC02a916164F178885B7ed05127D40847212

# Frontend copies of the active deployment addresses. Mainnet builds fail
# closed if any are absent; never reuse these testnet values on mainnet.
NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=0x8b59B3c4B7A634d8599e4DFB6891CEefd5CA424b
NEXT_PUBLIC_TREASURY_ADDRESS=0x2cAc61423fe5d7e74e5f3504901478F52a71156D
NEXT_PUBLIC_MIGRATOR_ADDRESS=0x34d4eC02a916164F178885B7ed05127D40847212
NEXT_PUBLIC_AMM_FACTORY_ADDRESS=0x4058646F179a4f5dF430E8e125b8F30fF3489BF9

# Deployer (testnet only — NEVER commit real values)
DEPLOYER_PRIVATE_KEY=

# Admin wallets — comma-separated EVM addresses allowed to register agents
# and manage the deployer wallet. Typically the same as the deployer wallet.
ADMIN_WALLETS=

# Backend — PostgreSQL (defaults match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orbafun
POSTGRES_USER=orbafun
POSTGRES_PASSWORD=orbafun_dev_password
# Production runtime must use this non-owner, non-BYPASSRLS role. For a
# Supabase pooler, the API derives orbafun_runtime.<project-ref> from the
# migration username postgres.<project-ref>; override POSTGRES_RUNTIME_USER
# only when your provider uses a different connection username.
POSTGRES_RUNTIME_ROLE=orbafun_runtime
POSTGRES_RUNTIME_USER=
POSTGRES_RUNTIME_PASSWORD=

# Backend — Redis
REDIS_URL=redis://localhost:6379

# API server
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Frontend (Next.js) — production values for the orba.fun domain.
# Set these in Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_SITE_URL is used for metadataBase (OG/Twitter cards) and must
# be the canonical production URL (no trailing slash).
# NEXT_PUBLIC_API_URL must point at the deployed backend (e.g. Render).
# NEXT_PUBLIC_WS_URL is the same host as the API (wss:// if the API serves TLS).
NEXT_PUBLIC_SITE_URL=https://orba.fun
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# TradingView Advanced Charts (licensed private GitHub repository).
# Local: point at your official charting_library clone.
# Vercel: set TRADINGVIEW_GITHUB_TOKEN as a Sensitive Environment Variable
# using the narrowest token GitHub permits for your licensed repository access.
# Never prefix these variables with NEXT_PUBLIC_ and never commit the token.
TRADINGVIEW_LIBRARY_PATH=
TRADINGVIEW_GITHUB_TOKEN=

# Auth (wallet signature auth for write endpoints)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Allow insecure x-wallet header fallback (testnet only — set to 'false' or remove for mainnet)
AUTH_ALLOW_INSECURE=false

# Indexer webhook authentication (shared secret between Envio and API)
INDEXER_WEBHOOK_SECRET=

# Envio HyperIndex (optional — for GraphQL polling fallback)
INDEXER_GRAPHQL_URL=http://localhost:8080/v1/graphql
INDEXER_GRAPHQL_SECRET=testing

# Circle App Kit (optional, if using App Kit features)
KIT_KEY=

# Pinata IPFS — for token image uploads on the launch form.
# Get a free key at https://app.pinata.cloud/ (Developers → API Keys).
# Leave empty to disable uploads (the launch form falls back to URL input).
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# AI Agent Launches — the deployer wallet submits createToken() on behalf
# of registered AI agents. The wallet must have USDC for the 5 USDC creation
# fee + gas. Fund it from the Circle faucet (testnet).
# Each launch approves only the exact current creation fee for TokenFactory.
# DEPLOYER_PRIVATE_KEY is shared with the e2e test scripts — same wallet.
# (Already set above, but documented here for the agent launch feature.)
AGENT_EXECUTOR_ENABLED=false  # set to true to enable autonomous agent executor

# Required for contract deployment and ownership migration. Use a Safe or
# equivalent hardware-backed multisig, never the Render deployer EOA.
ADMIN_MULTISIG=
AUTH_SIWE_DOMAINS=orba.fun,www.orba.fun,localhost:3000
POSTGRES_SSL_CA_BASE64=
REDIS_SSL_CA_BASE64=
TOKEN_FACTORY_APPROVAL_CAP_USDC=50000000
TRUST_PROXY_HOPS=1
