# Auto-detect line endings — Git converts to LF on commit, checks out OS-native
* text=auto

# TypeScript/JavaScript — always LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf

# Solidity — always LF
*.sol text eol=lf

# CSS/HTML/Config — always LF
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Shell scripts — always LF (must be LF to execute)
*.sh text eol=lf

# SQLx verifies migration checksums against exact file bytes.
near/backend/migrations/*.sql text eol=lf

# Batch scripts — always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Markdown — always LF
*.md text eol=lf

# Images — binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary

# Lockfiles — binary (do not merge)
package-lock.json -text
yarn.lock binary
pnpm-lock.yaml binary
